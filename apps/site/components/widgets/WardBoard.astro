---
// The Ward Board (plan 6.4): every model the reader has built, scored on the same three test sets.
// Rendered on the client from the notebook, so it carries across chapters. One test set at a time keeps it
// readable on a phone; the reader switches between Day Shift, Night Shift and the 2 a.m. Set.
interface Props { compact?: boolean; calibration?: boolean }
// `calibration` shows the calibration-error column; it is only explained on the Eleventh Night.
const { compact = false, calibration = false } = Astro.props;
const sets = [
  { split: 'day', name: 'Day Shift', note: 'Ordinary nights: messages like the ones in Bea\'s training pile.' },
  { split: 'night', name: 'Night Shift', note: 'New clinics, new words, voice-to-text and dialects Wick has never seen.' },
  { split: 'two_am', name: '2 a.m. Set', note: 'The rare, hard, high-stakes ones. A missed emergency here is the worst outcome on the board.' },
];
---
<section class:list={['ward-board', 'wide', { compact }]} aria-labelledby="ward-board-title" data-ward-board data-calibration={calibration ? '' : undefined}>
  <div class="head">
    <h2 id="ward-board-title">The Ward Board</h2>
    <div class="sets" role="radiogroup" aria-label="Test set">
      {sets.map((s, i) => (
        <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-set={s.split} data-note={s.note}>{s.name}</button>
      ))}
    </div>
  </div>
  <p class="note" data-note-text>{sets[0].note}</p>
  <div class="scroll">
    <table>
      <caption class="visually-hidden" data-caption>Scores on the Day Shift for every machine you have built</caption>
      <thead>
        <tr>
          <th scope="col">Machine</th>
          <th scope="col">Right</th>
          <th scope="col">Missed emergencies</th>
          <th scope="col">Needless alarms</th>
          <th scope="col" data-cal-col hidden>Calibration error</th>
        </tr>
      </thead>
      <tbody data-body>
        <tr><td colspan="4" class="loading">Loading the night's messages…</td></tr>
      </tbody>
    </table>
  </div>
  <p class="empty" data-empty>
    Two reference machines are already up: one that sends an ambulance for every message, and one that says
    everything can wait. Every machine you build joins them here.
  </p>
</section>

<script>
  import { load, CHANGE_EVENT, type ModelRecord } from '@primer/notebook';
  import { TEST_SETS, scoreModel, type SetScore } from '@primer/ward-board';
  import { loadCorpus } from '../../src/lib/corpus.ts';

  type Row = { name: string; scores: Record<string, SetScore>; reference?: boolean };
  let baselines: Row[] = [];
  let error = '';
  const pct = (x: number) => `${Math.round(x * 100)}%`;

  function render(root: HTMLElement) {
    const split = root.dataset.split ?? 'day';
    const models = load().models as (ModelRecord & { scores: Record<string, SetScore> })[];
    const rows: Row[] = [...baselines, ...models.map((m) => ({ name: m.name, scores: m.scores }))];
    root.querySelector<HTMLElement>('[data-empty]')!.hidden = models.length > 0;
    const body = root.querySelector('[data-body]')!;
    const setName = TEST_SETS.find((t) => t.split === split)?.name ?? split;
    root.querySelector('[data-caption]')!.textContent = `Scores on the ${setName.replace(/^The /, '')} for every machine you have built`;
    if (error) {
      body.innerHTML = `<tr><td colspan="4" class="loading"></td></tr>`;
      body.querySelector('td')!.textContent = error;
      return;
    }
    if (!baselines.length) return;
    const showCal = root.hasAttribute('data-calibration') && rows.some((r) => r.scores[split]?.calibrationError != null);
    root.querySelector<HTMLElement>('[data-cal-col]')!.hidden = !showCal;
    body.replaceChildren(
      ...rows.map((r) => {
        const s = r.scores[split];
        const tr = document.createElement('tr');
        if (r.reference) tr.className = 'reference';
        const th = document.createElement('th');
        th.scope = 'row';
        th.textContent = r.name;
        tr.append(th);
        const cells: [string, string][] = s
          ? [
              [pct(s.accuracy), ''],
              [String(s.missedEmergencies), s.missedEmergencies > 0 ? 'miss' : ''],
              [String(s.unnecessaryEscalations), ''],
              ...(showCal ? [[s.calibrationError == null ? '–' : s.calibrationError.toFixed(2), ''] as [string, string]] : []),
            ]
          : [['–', ''], ['–', ''], ['–', '']];
        const labels = ['Right', 'Missed emergencies', 'Needless alarms', 'Calibration error'];
        for (const [k, [text, cls]] of cells.entries()) {
          const td = document.createElement('td');
          td.textContent = text;
          td.dataset.label = labels[k];
          if (cls) td.className = cls;
          tr.append(td);
        }
        return tr;
      }),
    );
  }

  const roots = [...document.querySelectorAll<HTMLElement>('[data-ward-board]')];
  for (const root of roots) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-set]')];
    const choose = (b: HTMLButtonElement, focus = false) => {
      buttons.forEach((x) => {
        x.setAttribute('aria-checked', String(x === b));
        x.tabIndex = x === b ? 0 : -1;
      });
      if (focus) b.focus();
      root.dataset.split = b.dataset.set;
      root.querySelector('[data-note-text]')!.textContent = b.dataset.note ?? '';
      render(root);
    };
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => choose(b));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (d) { e.preventDefault(); choose(buttons[(i + d + buttons.length) % buttons.length], true); }
      });
    });
    addEventListener(CHANGE_EVENT, () => render(root));
    addEventListener('storage', () => render(root));
  }

  loadCorpus()
    .then((c) => {
      baselines = [
        { name: 'Ambulance for everyone', scores: scoreModel(c.messages, () => ({ label: 'urgent' })), reference: true },
        { name: 'Everything can wait', scores: scoreModel(c.messages, () => ({ label: 'can_wait' })), reference: true },
      ];
    })
    .catch((e) => (error = e.message))
    .finally(() => roots.forEach(render));
</script>

<style>
  .ward-board {
    margin-block: 3rem; padding: 1.25rem clamp(1rem, 3vw, 1.75rem) 1rem;
    background: var(--card); border: 1px solid var(--ink); border-radius: var(--radius-ui);
    font-family: var(--font-ui); font-size: var(--step--1);
  }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.75rem 1rem; }
  h2 { margin: 0; font-size: var(--step-2); }
  .compact h2 { font-size: var(--step-1); }
  .sets { display: inline-flex; border: 1px solid var(--ink); border-radius: 999px; overflow: hidden; }
  .sets button {
    border: 0; background: transparent; padding: 0.35rem 0.85rem; cursor: pointer; min-height: 2.75rem;
    font-size: var(--step--1);
  }
  .sets button + button { border-left: 1px solid var(--ink); }
  .sets button[aria-checked='true'] { background: var(--ink); color: var(--paper); font-weight: 700; }
  .note { color: var(--ink-soft); margin: 0.6rem 0 0.5rem; }
  .empty { color: var(--ink-soft); margin: 0.75rem 0 0; font-style: italic; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  :global(.ward-board th), :global(.ward-board td) { padding: 0.45rem 0.6rem; text-align: right; border-bottom: 1px solid var(--rule); }
  th[hidden] { display: none; }
  thead th { font-weight: 700; vertical-align: bottom; font-size: 0.8rem; color: var(--ink-soft); }
  th:first-child { text-align: left; }
  :global(.ward-board tbody th) { text-align: left; font-weight: 700; }
  :global(.ward-board td.miss) { color: var(--alarm); font-weight: 700; }
  :global(.ward-board tr.reference) { color: var(--ink-soft); }
  :global(.ward-board tr.reference th) { font-weight: 400; font-style: italic; }
  :global(.ward-board td.loading) { text-align: left; color: var(--ink-soft); }
  /* Phones: each machine becomes a small card instead of a wide row. */
  @media (max-width: 34rem) {
    .sets { width: 100%; }
    .sets button { flex: 1; padding-inline: 0.4rem; }
    thead { display: none; }
    table, :global(.ward-board tbody), :global(.ward-board tr) { display: block; }
    :global(.ward-board tr) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.25rem 0.5rem; padding: 0.6rem 0; border-bottom: 1px solid var(--rule); }
    :global(.ward-board tbody th) { grid-column: 1 / -1; border: 0; padding: 0; }
    :global(.ward-board td) { border: 0; padding: 0; text-align: left; font-size: var(--step-0); font-weight: 700; }
    :global(.ward-board td::before) { content: attr(data-label); display: block; font-size: 0.72rem; font-weight: 400; color: var(--ink-soft); }
    :global(.ward-board td.loading::before) { content: none; }
  }
</style>
