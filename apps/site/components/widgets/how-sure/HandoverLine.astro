---
// The Eleventh Night, second widget: one slider for a value choice. "How many needless ambulances is one missed
// emergency worth?" sets Wick's handover line (escalate when the needle reads at least 1 / (1 + ratio)); a
// tradeoff chart shows every line Wick could have, and where yours sits, on the Ward Board's three sets.
import { SETS, RATIOS, DEFAULT_RATIO } from './store.ts';
const start = RATIOS.indexOf(DEFAULT_RATIO as (typeof RATIOS)[number]);
// Dial geometry: a half circle, 0% on the left, 100% on the right.
const CX = 110, CY = 104, R = 84;
---
<div class="handover" data-handover>
  <div class="ask">
    <label for="cost-ratio" class="ask-q">How many needless ambulances is one missed emergency worth?</label>
    <div class="ask-row">
      <input id="cost-ratio" type="range" min="0" max={RATIOS.length - 1} step="1" value={start} data-ratio-input
        aria-valuetext={`${DEFAULT_RATIO} needless ambulances`} />
      <output for="cost-ratio" class="ratio" data-ratio-out>{DEFAULT_RATIO}</output>
    </div>
    <p class="ends"><span>1: they're equal</span><span>100</span></p>
  </div>

  <div class="line-row">
    <svg class="dial" viewBox="0 0 220 130" aria-hidden="true" focusable="false">
      <path d={`M${CX - R} ${CY} A${R} ${R} 0 0 1 ${CX + R} ${CY}`} class="dial-rim" />
      <path d="" class="dial-zone" data-zone />
      <line x1={CX} y1={CY} x2={CX} y2={CY - R} class="dial-line" data-mark />
      <circle cx={CX} cy={CY} r="7" class="dial-hub" />
      <text x={CX - R} y={CY + 22} class="dial-t" text-anchor="middle">0</text>
      <text x={CX + R} y={CY + 22} class="dial-t" text-anchor="middle">100%</text>
      <text x={CX} y={CY - 26} class="dial-t dial-you" text-anchor="middle" data-you-label>your line</text>
    </svg>
    <p class="line-text" data-line-text aria-live="polite"></p>
  </div>

  <div class="sets" role="radiogroup" aria-label="Test set for the chart">
    {SETS.map((s, i) => (
      <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-set={s.split}>{s.short}</button>
    ))}
  </div>

  <figure class="chart">
    <figcaption class="chart-title" data-chart-title>Lines from 1% to 50%, on the Day Shift</figcaption>
    <svg viewBox="0 0 600 330" role="img" aria-labelledby="tradeoff-title tradeoff-desc">
      <title id="tradeoff-title">Missed emergencies against needless alarms</title>
      <desc id="tradeoff-desc" data-desc>Loading.</desc>
      <defs>
        <pattern id="trade-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="6" class="hatch-line" />
        </pattern>
      </defs>
      <line x1="80" y1="20" x2="80" y2="270" class="axis" />
      <line x1="80" y1="270" x2="580" y2="270" class="axis" />
      <text x="70" y="278" class="tick" text-anchor="end">0</text>
      <text x="70" y="40" class="tick" text-anchor="end" data-ymax></text>
      <text x="80" y="300" class="tick" text-anchor="middle">0</text>
      <text x="580" y="300" class="tick" text-anchor="end" data-xmax></text>
      <path d="" class="under" data-under />
      <path d="" class="curve" data-curve />
      <circle r="8" class="half" data-half cx="-20" cy="-20" />
      <text class="tick half-t" data-half-t x="-50" y="-50">50% line</text>
      <circle r="10" class="you" data-you cx="-20" cy="-20" />
      <text class="tick you-t" data-you-t x="-50" y="-50"></text>
    </svg>
    <p class="axis-y-note"><span class="miss-t">↑ missed emergencies</span><span>needless alarms →</span></p>
  </figure>

  <ul class="sets-table" data-table aria-live="polite"></ul>

  <div class="actions">
    <button type="button" class="btn primary" data-save disabled>Put Wick with this handover line on the Ward Board</button>
    <span class="saved" data-saved aria-live="polite"></span>
  </div>
  <div class="rogues" data-rogues></div>
</div>

<script>
  import { thresholdSweep, atThreshold, defaultGrid } from '@primer/ward-board';
  import { CHANGE_EVENT, load } from '@primer/notebook';
  import { mountRogues } from '../../../src/lib/rogues.ts';
  import { wickReadings, SETS, RATIOS, costsFor, lineFor, getRatio, setRatio, onRatio, saveHandover, type TestSplit } from './store.ts';

  const CX = 110, CY = 104, R = 84;
  const PX0 = 80, PX1 = 580, PY0 = 270, PY1 = 20;
  const root = document.querySelector<HTMLElement>('[data-handover]')!;
  const input = root.querySelector<HTMLInputElement>('[data-ratio-input]')!;
  const setButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-set]')];
  let split: TestSplit = 'day';
  const pct = (t: number) => `${Math.round(t * 100)}%`;
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
  const setName = (s: TestSplit) => SETS.find((x) => x.split === s)!.name;

  function dialPoint(f: number, r = R) {
    const a = Math.PI * (1 - f);
    return [CX + r * Math.cos(a), CY - r * Math.sin(a)];
  }

  wickReadings().then(({ c, wick, readings }) => {
    const save = root.querySelector<HTMLButtonElement>('[data-save]')!;
    save.disabled = false;

    function drawDial(t: number) {
      const [ax, ay] = dialPoint(t);
      const [bx, by] = dialPoint(1);
      root.querySelector('[data-zone]')!.setAttribute('d', `M${ax.toFixed(1)} ${ay.toFixed(1)} A${R} ${R} 0 0 1 ${bx} ${by}`);
      const [mx, my] = dialPoint(t, R + 12);
      const [nx, ny] = dialPoint(t, R - 18);
      const mark = root.querySelector('[data-mark]')!;
      mark.setAttribute('x1', nx.toFixed(1)); mark.setAttribute('y1', ny.toFixed(1));
      mark.setAttribute('x2', mx.toFixed(1)); mark.setAttribute('y2', my.toFixed(1));
      // "your line" sits just inside the tick.
      const [lx, ly] = dialPoint(t, R - 30);
      const label = root.querySelector('[data-you-label]')!;
      label.setAttribute('x', (lx + (t < 0.35 ? -4 : 0)).toFixed(1));
      label.setAttribute('y', (Math.min(ly, CY - 18) + 4).toFixed(1));
      label.setAttribute('text-anchor', t < 0.35 ? 'start' : 'middle');
    }

    function drawChart(t: number, r: number) {
      const items = readings[split];
      // Every line from 1% to 50% (above the middle nothing interesting happens), plus yours: the board's
      // line sits just under 1%. The axes fit that range, so the curve fills the box instead of hugging it.
      const grid = [...new Set([...defaultGrid().filter((g) => g <= 0.5), t])].sort((x, y) => x - y);
      const sweep = thresholdSweep(items, costsFor(r), grid);
      const low = sweep[0], high = sweep.at(-1)!;
      const xMax = Math.max(10, Math.ceil(low.alarms / 10) * 10);
      const yMax = Math.max(10, Math.ceil(high.missed / 10) * 10);
      const X = (a: number) => PX0 + ((PX1 - PX0) * a) / xMax;
      const Y = (m: number) => PY0 - ((PY0 - PY1) * m) / yMax;
      const pts = sweep.map((s) => [X(s.alarms), Y(s.missed)]);
      const d = 'M' + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L');
      root.querySelector('[data-curve]')!.setAttribute('d', d);
      root.querySelector('[data-under]')!.setAttribute('d', `${d} L${pts.at(-1)![0].toFixed(1)} ${PY0} L${pts[0][0].toFixed(1)} ${PY0} Z`);
      root.querySelector('[data-xmax]')!.textContent = String(xMax);
      root.querySelector('[data-ymax]')!.textContent = String(yMax);
      const half = atThreshold(items, 0.5, costsFor(r));
      const you = atThreshold(items, t, costsFor(r));
      // Labels sit above and to the right of their dots: the curve bends toward the corner, so that space is empty.
      const place = (sel: string, label: string, s: { alarms: number; missed: number }, text: string) => {
        const cx = X(s.alarms), cy = Y(s.missed);
        const dot = root.querySelector(sel)!;
        dot.setAttribute('cx', cx.toFixed(1)); dot.setAttribute('cy', cy.toFixed(1));
        const tx = root.querySelector<SVGTextElement>(label)!;
        tx.textContent = text;
        tx.setAttribute('x', (cx + 14).toFixed(1));
        tx.setAttribute('y', Math.max(PY1 + 18, cy - 14).toFixed(1));
      };
      place('[data-half]', '[data-half-t]', half, Math.abs(t - 0.5) < 0.005 ? '' : '50% line');
      place('[data-you]', '[data-you-t]', you, `your line, ${pct(t)}`);
      root.querySelector('[data-chart-title]')!.textContent = `Lines from 1% to 50%, on the ${setName(split).replace(/^The /, '')}`;
      root.querySelector('[data-desc]')!.textContent =
        `A curve from ${high.missed} missed emergencies and ${high.alarms} needless alarms (line at 50%) to ${low.missed} missed and ${low.alarms} needless alarms (line at ${pct(low.threshold)}). At the 50% line: ${half.missed} missed, ${half.alarms} needless. At your line of ${pct(t)}: ${you.missed} missed, ${you.alarms} needless.`;
    }

    function table(t: number, r: number) {
      const ul = root.querySelector('[data-table]')!;
      ul.replaceChildren(...SETS.map(({ split: s, name }) => {
        const you = atThreshold(readings[s], t, costsFor(r));
        const half = atThreshold(readings[s], 0.5, costsFor(r));
        const li = document.createElement('li');
        li.innerHTML = `<span class="set-name"></span>
          <span class="cell"><strong class="miss-n"></strong> missed</span>
          <span class="cell"><strong class="alarm-n"></strong> needless</span>
          <span class="was"></span>`;
        li.querySelector('.set-name')!.textContent = name;
        li.querySelector('.miss-n')!.textContent = String(you.missed);
        li.querySelector('.alarm-n')!.textContent = String(you.alarms);
        li.querySelector('.was')!.textContent = `at the 50% line: ${half.missed} missed, ${half.alarms} needless`;
        return li;
      }));
    }

    function update() {
      const r = getRatio();
      const t = lineFor(r);
      root.querySelector('[data-ratio-out]')!.textContent = String(r);
      input.setAttribute('aria-valuetext', `${r} needless ${r === 1 ? 'ambulance' : 'ambulances'}; handover line ${pct(t)}`);
      root.querySelector('[data-line-text]')!.textContent =
        `${r === 1 ? 'One missed emergency is worth one needless ambulance' : `One missed emergency is worth ${r} needless ambulances`}, so Wick hands a message to a nurse whenever its needle reads ${pct(t)} or more.`;
      drawDial(t);
      drawChart(t, r);
      table(t, r);
      root.querySelector('[data-saved]')!.textContent = '';
      // Let the Rogues' report (and anything else listening) redraw with the new line.
      dispatchEvent(new CustomEvent(CHANGE_EVENT));
    }

    input.addEventListener('input', () => setRatio(RATIOS[Number(input.value)]));
    onRatio(update);
    setButtons.forEach((b, i) => {
      const choose = (x: HTMLButtonElement, focus = false) => {
        setButtons.forEach((y) => { y.setAttribute('aria-checked', String(y === x)); y.tabIndex = y === x ? 0 : -1; });
        if (focus) x.focus();
        split = x.dataset.set as TestSplit;
        drawChart(lineFor(getRatio()), getRatio());
      };
      b.addEventListener('click', () => choose(b));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (d) { e.preventDefault(); choose(setButtons[(i + d + setButtons.length) % setButtons.length], true); }
      });
    });
    save.addEventListener('click', () => {
      saveHandover(c, wick, getRatio());
      root.querySelector('[data-saved]')!.textContent = `On the board, with its line at ${pct(lineFor(getRatio()))}.`;
    });
    // Only show the Rogues' Gallery to readers who have one (it's filled on the Third Night).
    const roguesEl = root.querySelector<HTMLElement>('[data-rogues]')!;
    const showRogues = () => (roguesEl.hidden = !(load().rogues ?? []).length);
    mountRogues(roguesEl, (text) => (wick.pUrgent(text) >= lineFor(getRatio()) ? 'urgent' : 'can_wait'), 'Wick with your handover line');
    showRogues();
    addEventListener(CHANGE_EVENT, showRogues);
    update();
  }).catch((e) => (root.querySelector('[data-line-text]')!.textContent = e.message));
</script>

<style>
  .btn { min-height: 2.75rem; }
  .btn[hidden] { display: none; }
  .ask-q { display: block; font-weight: 700; font-size: var(--step-0); margin-bottom: 0.4rem; }
  .ask-row { display: flex; align-items: center; gap: 1rem; }
  .ask-row input { flex: 1; min-height: 2.75rem; accent-color: var(--gold-ink); margin: 0; }
  .ratio { font-size: var(--step-2); font-weight: 700; min-width: 3ch; text-align: right; font-variant-numeric: tabular-nums; color: var(--gold-ink); }
  .ends { display: flex; justify-content: space-between; margin: 0 4.5ch 0 0; color: var(--ink-soft); font-size: 0.8rem; }
  .line-row { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; align-items: center; margin: 1rem 0; }
  .dial { width: 11rem; flex: none; }
  .dial-rim { fill: none; stroke: var(--rule); stroke-width: 14; }
  .dial-zone { fill: none; stroke: var(--gold); stroke-width: 14; }
  .dial-line { stroke: var(--ink); stroke-width: 3; }
  .dial-hub { fill: var(--gold); stroke: var(--ink); stroke-width: 1.5; }
  .dial-t { font-family: var(--font-ui); font-size: 15px; fill: var(--ink-soft); }
  .dial-you { fill: var(--ink); font-weight: 700; }
  .rogues[hidden] { display: none; }
  .line-text { flex: 1 1 14rem; margin: 0; }
  .sets { display: inline-flex; border: 1px solid var(--ink); border-radius: 999px; overflow: hidden; margin-bottom: 0.75rem; }
  .sets button { border: 0; background: transparent; padding: 0.35rem 1rem; min-height: 2.75rem; cursor: pointer; font-size: var(--step--1); }
  .sets button + button { border-left: 1px solid var(--ink); }
  .sets button[aria-checked='true'] { background: var(--ink); color: var(--paper); font-weight: 700; }
  .chart { margin: 0; max-width: 38rem; }
  .chart-title { font-weight: 700; margin-bottom: 0.3rem; }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .axis { stroke: var(--ink); stroke-width: 1; }
  .tick { font-family: var(--font-ui); font-size: 22px; fill: var(--ink-soft); }
  .hatch-line { stroke: var(--ink); stroke-width: 1; opacity: 0.25; }
  .under { fill: url(#trade-hatch); }
  .curve { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  .half { fill: var(--card); stroke: var(--ink); stroke-width: 2.5; }
  .you { fill: var(--gold); stroke: var(--ink); stroke-width: 2; }
  .you-t { fill: var(--ink); font-weight: 700; }
  .half-t { fill: var(--ink-soft); }
  .you-t, .half-t { paint-order: stroke; stroke: var(--card); stroke-width: 6px; stroke-linejoin: round; }
  .axis-y-note { display: flex; justify-content: space-between; margin: 0.3rem 0 0; color: var(--ink-soft); font-size: 0.85rem; }
  .miss-t { color: var(--alarm); }
  .sets-table { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.4rem; }
  :global(.handover .sets-table li) {
    display: grid; grid-template-columns: 9rem 6.5rem 7rem 1fr; gap: 0.2rem 0.75rem; align-items: baseline;
    padding: 0.45rem 0; border-bottom: 1px solid var(--rule); font-variant-numeric: tabular-nums;
  }
  :global(.handover .set-name) { font-weight: 700; }
  :global(.handover .cell strong) { font-size: var(--step-1); margin-right: 0.2rem; }
  :global(.handover .miss-n) { color: var(--alarm); }
  :global(.handover .was) { color: var(--ink-soft); font-size: 0.85rem; }
  @media (max-width: 40rem) {
    :global(.handover .sets-table li) { grid-template-columns: 1fr 1fr; }
    :global(.handover .set-name), :global(.handover .was) { grid-column: 1 / -1; }
  }
  @media (max-width: 34rem) {
    .sets { display: flex; width: 100%; }
    .sets button { flex: 1; padding-inline: 0.4rem; }
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-top: 1.25rem; }
  .saved { color: var(--calm); font-weight: 700; }
  .rogues { margin-top: 1rem; font-size: 0.85rem; }
  :global(.handover .rogues-title) { font-weight: 700; margin: 0 0 0.3rem; }
  :global(.handover .rogues-report ul) { margin: 0; padding-left: 1.2rem; }
  :global(.handover .rogues-report li.still span) { color: var(--gold-ink); font-weight: 700; }
</style>
