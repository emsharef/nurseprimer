<aside class="night-note" aria-labelledby="night-note-title">
  <h2 id="night-note-title">Night Note</h2>
  <div class="lines"><slot /></div>
</aside>

<style>
  .night-note {
    margin-block: 3.5rem 3rem; padding: 1.75rem clamp(1rem, 4vw, 2rem) 1.5rem;
    background: var(--paper-2); border-radius: var(--radius-ui);
    border-top: 3px solid var(--gold);
  }
  h2 { margin: 0 0 1.25rem; font-size: var(--step-2); font-style: italic; }
  .lines { display: grid; gap: 1.1rem; }
</style>
