---
// The chapter opener: the title printed on a patient wristband. The barcode is drawn from the title's
// characters so each chapter's band is its own; it is decoration and hidden from assistive tech.
interface Props { number: number | null; title: string; summary: string }
const { number, title, summary } = Astro.props;
const label = number == null ? 'Coda' : `Chapter ${number}`;
const bars: { x: number; w: number }[] = [];
let x = 0;
for (const ch of (title + label).split('')) {
  const c = ch.charCodeAt(0);
  const w = 1 + (c % 3);
  bars.push({ x, w });
  x += w + 1 + ((c >> 2) % 3);
}
---
<header class="band-wrap">
  <div class="band">
    <span class="hole" aria-hidden="true"></span>
    <div class="text">
      <p class="label">{label}</p>
      <h1>{title}</h1>
    </div>
    <svg class="barcode" viewBox={`0 0 ${x} 40`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="40" />)}
    </svg>
  </div>
  <p class="summary">{summary}</p>
</header>

<style>
  .band-wrap { padding: clamp(2rem, 7vw, 4.5rem) var(--gutter) 1.5rem; max-width: var(--wide); margin-inline: auto; }
  .band {
    position: relative;
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(0.75rem, 3vw, 2rem);
    background: var(--band); color: #1c2a3a;
    border: 1px solid var(--band-edge);
    border-radius: var(--radius-band);
    padding: clamp(0.9rem, 3vw, 1.5rem) clamp(1rem, 4vw, 2.25rem);
    box-shadow: 0 1px 0 var(--band-edge), 0 18px 40px -28px rgb(20 40 60 / 0.55);
    transform: rotate(-1.2deg);
  }
  .hole { width: 0.85rem; height: 0.85rem; border-radius: 50%; border: 2px solid var(--band-edge); background: var(--linen); }
  .label { margin: 0; font-family: var(--font-mono); font-size: var(--step--1); color: #46576a; }
  h1 { margin: 0.15em 0 0; font-size: clamp(var(--step-2), 6vw, var(--step-4)); letter-spacing: -0.02em; }
  .barcode { width: clamp(3.5rem, 12vw, 8rem); height: 3rem; fill: #1c2a3a; }
  .summary {
    max-width: var(--measure); margin: 2rem auto 0;
    font-size: var(--step-1); line-height: 1.45; color: var(--ink-soft);
  }
  @media (max-width: 30rem) {
    .band { grid-template-columns: auto 1fr; }
    .barcode { display: none; }
  }
</style>
