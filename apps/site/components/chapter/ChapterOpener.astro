---
// The chapter's title page: which night it is, the title in letterpress, the opening plate, and a line of
// what happens tonight.
import Plate from './Plate.astro';

import { nightName } from '../../src/lib/ladder.ts';
interface Props { number: number | null; title: string; summary: string; plate?: string }
const { number, title, summary, plate } = Astro.props;
const night = nightName(number);
---
<header class="opener">
  <p class="night">{night}</p>
  <h1>{title}</h1>
  <svg class="flourish" viewBox="0 0 200 16" aria-hidden="true" focusable="false">
    <path d="M4 8 C40 2, 70 14, 100 8 S160 2, 196 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <circle cx="100" cy="8" r="3.2" fill="var(--gold)" />
  </svg>
  {plate && <div class="opener-plate"><Plate id={plate} size="wide" eager /></div>}
  <p class="summary">{summary}</p>
</header>

<style>
  .opener {
    text-align: center;
    padding: clamp(2rem, 7vw, 4.5rem) var(--gutter) 1rem;
    max-width: var(--wide); margin-inline: auto;
  }
  .night {
    margin: 0; font-family: var(--font-display); font-style: italic; font-size: var(--step-1);
    color: var(--gold-ink); letter-spacing: 0.01em;
  }
  h1 { margin: 0.1em 0 0.2em; font-size: clamp(var(--step-4), 9vw, var(--step-5)); }
  .flourish { width: 11rem; color: var(--ink-soft); display: block; margin: 0 auto; }
  .opener-plate :global(.plate) { margin-block: 1.5rem 0.5rem; }
  .summary {
    max-width: 40ch; margin: 1.5rem auto 0;
    font-size: var(--step-1); line-height: 1.45; font-style: italic; color: var(--ink-soft);
  }
</style>
