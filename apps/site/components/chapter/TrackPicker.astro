---
// Adaptive depth (plan 3): the reader reads as a nurse, a coder, or just curious. Stored in the notebook.
const tracks = [
  { id: 'nurse', label: 'Nurse' },
  { id: 'coder', label: 'Coder' },
  { id: 'curious', label: 'Curious' },
];
---
<div class="track" role="group" aria-label="Read as">
  <span class="label" aria-hidden="true">Read as</span>
  {tracks.map((t) => <button type="button" data-track-choice={t.id} aria-pressed="false">{t.label}</button>)}
</div>

<script>
  import { load, setTrack, type Track } from '@primer/notebook';
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-track-choice]');
  function show(track: Track | null) {
    if (track) document.documentElement.dataset.track = track;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.trackChoice === track)));
  }
  show(load().track);
  buttons.forEach((b) => b.addEventListener('click', () => show(setTrack(b.dataset.trackChoice as Track).track)));
</script>

<style>
  .track { display: flex; align-items: center; gap: 0.25rem; font-size: var(--step--1); }
  .label { color: var(--ink-soft); margin-right: 0.25rem; }
  button {
    border: 1px solid var(--rule); background: var(--paper); border-radius: 999px;
    padding: 0.2rem 0.75rem; cursor: pointer; min-height: 2rem;
  }
  button[aria-pressed='true'] { background: var(--lamp-bg); border-color: var(--lamp); font-weight: 700; }
</style>
