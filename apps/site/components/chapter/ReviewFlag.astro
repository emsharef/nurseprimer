---
// Plan 12: visible TODO(review) flags on AI-drafted prose and unreviewed medical content.
interface Props { prose: 'ai-draft' | 'human-edited'; medical: 'unreviewed' | 'clinician-reviewed' | 'none' }
const { prose, medical } = Astro.props;
const items: string[] = [];
if (prose === 'ai-draft') items.push('The prose in this chapter was drafted by AI and has not yet had a human edit.');
if (medical === 'unreviewed') items.push('Medical statements, labels and pictures here have not yet been reviewed by a clinician.');
---
{items.length > 0 && (
  <div class="column"><div class="review-flag" role="note">
    <p><code>TODO(review)</code></p>
    <ul>{items.map((i) => <li>{i}</li>)}</ul>
  </div></div>
)}

<style>
  .review-flag {
    font-family: var(--font-ui); font-size: var(--step--1);
    border: 2px dashed var(--lamp); border-radius: var(--radius-ui);
    padding: 0.75rem 1rem; margin-block: 0 2rem;
    background: var(--lamp-bg);
  }
  .review-flag p { margin: 0 0 0.25rem; font-weight: 700; }
  ul { margin: 0; padding-left: 1.2rem; }
</style>
