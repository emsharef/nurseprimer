---
// Predict before reveal (plan 4.2): the reader commits to a guess before seeing a result.
// With `lock`, the widget right after this box stays locked (with a visible note) until the reader guesses.
// With `answer`, the right answer is NOT shown at guess time: a "check my guess" bar appears after the widget,
// so the reader finds out by doing first. The slot is a short instruction shown once they've guessed.
interface Props { id: string; question: string; options: string[]; answer?: string; lock?: boolean }
const { id, question, options, answer, lock = false } = Astro.props;
---
<div class="predict" data-predict={id} data-answer={answer ?? ''} data-lock={lock ? '' : undefined}>
  <p class="q" id={`${id}-q`}><strong>Your guess:</strong> {question}</p>
  <div class="options" role="group" aria-labelledby={`${id}-q`}>
    {options.map((o) => <button type="button" data-option={o} aria-pressed="false">{o}</button>)}
  </div>
  <p class="verdict" data-predict-verdict aria-live="polite"></p>
  <div class="reveal" data-reveal hidden><slot /></div>
</div>

<script>
  // The next real element after the box (skipping the scripts and styles Astro may place in between).
  function nextWidget(el: Element): HTMLElement | null {
    let n = el.nextElementSibling;
    while (n && (n.tagName === 'SCRIPT' || n.tagName === 'STYLE')) n = n.nextElementSibling;
    return n as HTMLElement | null;
  }

  document.querySelectorAll<HTMLElement>('[data-predict]').forEach((root) => {
    const answer = root.dataset.answer;
    const verdict = root.querySelector<HTMLElement>('[data-predict-verdict]')!;
    const reveal = root.querySelector<HTMLElement>('[data-reveal]')!;
    const locked = root.hasAttribute('data-lock') ? nextWidget(root) : null;
    let note: HTMLElement | null = null;
    if (locked) {
      locked.classList.add('predict-locked');
      locked.setAttribute('inert', '');
      note = document.createElement('p');
      note.className = 'lock-note';
      note.textContent = 'Make your guess above to unlock this.';
      locked.prepend(note);
    }
    let check: HTMLElement | null = null;

    root.querySelectorAll<HTMLButtonElement>('[data-option]').forEach((b) =>
      b.addEventListener('click', () => {
        root.querySelectorAll('[data-option]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const guess = b.dataset.option!;
        verdict.textContent = `You guessed "${guess}". Now try it.`;
        reveal.hidden = !reveal.textContent?.trim();
        if (locked) {
          locked.removeAttribute('inert');
          locked.classList.remove('predict-locked');
          note?.remove();
        }
        if (answer && !check) {
          // Offer the answer after the widget, once the reader has had a go.
          check = document.createElement('div');
          check.className = 'predict-check';
          check.innerHTML = `<button type="button" class="btn">Check my guess</button><p aria-live="polite"></p>`;
          if (locked?.classList.contains('wide')) check.classList.add('wide');
          (locked ?? root).after(check);
          check.querySelector('button')!.addEventListener('click', () => {
            const g = root.querySelector<HTMLElement>('[aria-pressed="true"]')?.dataset.option ?? guess;
            check!.querySelector('p')!.textContent =
              g === answer ? `You guessed "${g}". You were right.` : `You guessed "${g}". It was "${answer}".`;
            check!.querySelector('button')!.remove();
          });
        }
        root.dispatchEvent(new CustomEvent('primer:revealed', { bubbles: true, detail: { guess } }));
      }),
    );
  });
</script>

<style>
  .predict {
    margin-block: 2rem; padding: 1rem 1.25rem; border-radius: var(--radius-ui);
    border: 2px solid var(--gold); background: var(--card);
  }
  .q { margin: 0 0 0.75rem; }
  .options { display: flex; flex-wrap: wrap; gap: 0.5rem; font-family: var(--font-ui); }
  button {
    border: 1px solid var(--rule); background: var(--paper); border-radius: var(--radius-ui);
    padding: 0.45rem 0.9rem; cursor: pointer; min-height: 2.75rem; font-size: var(--step--1); text-align: left;
  }
  button[aria-pressed='true'] { background: var(--gold-wash); border-color: var(--gold-ink); font-weight: 700; }
  .verdict { font-family: var(--font-ui); font-size: var(--step--1); margin: 0.75rem 0 0; }
  .verdict:empty { display: none; }
  .reveal { margin-top: 0.75rem; }
  .reveal :global(> :last-child) { margin-bottom: 0; }
  :global(.predict-locked) { position: relative; }
  :global(.predict-locked > :not(.lock-note)) { opacity: 0.45; filter: blur(7px) grayscale(0.6); pointer-events: none; user-select: none; }
  :global(.lock-note) {
    position: sticky; top: 0.75rem; z-index: 2; margin: 0; padding: 0.75rem 1rem;
    background: var(--gold-wash); color: var(--ink); border-bottom: 1px solid var(--gold-ink);
    font-family: var(--font-ui); font-weight: 700; text-align: center;
  }
  :global(.predict-check) {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem;
    margin: -1.5rem 0 2.5rem; padding: 0.75rem 1rem; border: 2px solid var(--gold); border-top: 0;
    border-radius: 0 0 var(--radius-ui) var(--radius-ui); font-family: var(--font-ui);
  }
  :global(.predict-check p) { margin: 0; font-weight: 700; }
  :global(.predict-check p:empty) { display: none; }
</style>
