---
<button type="button" class="theme" data-theme-toggle aria-pressed="false">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor"/></svg>
  Night pages
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  const sync = () => btn.setAttribute('aria-pressed', String(isDark()));
  sync();
  btn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('primer.theme', next); } catch {}
    sync();
  });
</script>

<style>
  .theme {
    display: inline-flex; align-items: center; gap: 0.4rem;
    border: 1.5px solid var(--rule); background: transparent; border-radius: 999px;
    padding: 0.25rem 0.95rem; cursor: pointer; min-height: 2.75rem; font-size: var(--step--1);
  }
  .theme[aria-pressed='true'] { border-color: var(--gold); color: var(--gold-ink); }
</style>
