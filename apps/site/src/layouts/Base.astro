---
import '../../styles/base.css';
import TrackPicker from '../../components/chapter/TrackPicker.astro';
import ThemeToggle from '../../components/chapter/ThemeToggle.astro';

interface Props { title: string; description?: string }
const { title, description = 'Learn how modern AI works by building a telephone-triage nurse in your browser.' } = Astro.props;
const version = __PRIMER_VERSION__;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="primer-version" content={version} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Apply saved theme and track before first paint. Storage may be missing or throw; that is fine.
      try {
        var t = localStorage.getItem('primer.theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        var nb = JSON.parse(localStorage.getItem('primer.notebook.v1') || 'null');
        if (nb && nb.track) document.documentElement.dataset.track = nb.track;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the reading</a>
    <header class="site-header">
      <a class="home" href={base}>A Young Nurse's Illustrated Primer</a>
      <div class="controls">
        <TrackPicker />
        <ThemeToggle />
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="column">
        <p class="disclaimer">
          This book teaches how AI works. It is not medical or triage advice. If you are worried about someone's
          health, call your local emergency number or a nurse line.
        </p>
        <p class="meta">
          <a href={`${base}about/`}>About this book, its sources and reviewers</a>
          <span class="version">Edition <span data-version>{version}</span></span>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; justify-content: space-between;
    padding: 0.75rem var(--gutter);
    font-family: var(--font-ui);
    border-bottom: 1px solid var(--rule);
  }
  .home { font-weight: 700; text-decoration: none; font-size: var(--step--1); }
  .controls { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  main { padding-bottom: 4rem; }
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem 3rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .disclaimer { color: var(--ink); max-width: 52ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; }
</style>
