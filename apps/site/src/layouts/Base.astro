---
import '../../styles/base.css';
import ThemeToggle from '../../components/chapter/ThemeToggle.astro';

interface Props { title: string; description?: string }
const { title, description = 'An illustrated adventure in which you build a little machine that learns, and find out how modern AI works.' } = Astro.props;
const version = __PRIMER_VERSION__;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="primer-version" content={version} />
    <meta name="theme-color" content="#f8f3e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a30" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Apply the saved page colour before first paint. Storage may be missing or throw; that is fine.
      try {
        var t = localStorage.getItem('primer.theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the story</a>
    <header class="site-header">
      <a class="home" href={base}>A Young Nurse's Illustrated Primer</a>
      <ThemeToggle />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="column">
        <p class="disclaimer">
          This is a story about how AI works, not medical advice. If you're worried about someone's health, call
          your local emergency number or a nurse line.
        </p>
        <p class="meta">
          <a href={`${base}about/`}>How this book was made</a>
          <span>Edition <span data-version>{version}</span></span>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; justify-content: space-between;
    padding: 0.8rem var(--gutter);
  }
  .home { font-family: var(--font-display); font-size: var(--step-1); text-decoration: none; font-style: italic; }
  main { padding-bottom: 4rem; }
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem 3rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .disclaimer { color: var(--ink); max-width: 52ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; }
</style>
