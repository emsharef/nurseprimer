---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChapterOpener from '../../../components/chapter/ChapterOpener.astro';
import Plate from '../../../components/chapter/Plate.astro';
import ReviewFlag from '../../../components/chapter/ReviewFlag.astro';
import References from '../../../components/chapter/References.astro';
import WardBoard from '../../../components/widgets/WardBoard.astro';
import Widget from '../../../components/chapter/Widget.astro';
import NightNote from '../../../components/chapter/NightNote.astro';
import Line from '../../../components/chapter/Line.astro';
import MathDrawer from '../../../components/chapter/MathDrawer.astro';
import Cite from '../../../components/chapter/Cite.astro';
import NoteRef from '../../../components/chapter/NoteRef.astro';
import NoteDef from '../../../components/chapter/NoteDef.astro';
import Notes from '../../../components/chapter/Notes.astro';
import Predict from '../../../components/chapter/Predict.astro';
import Transcript from '../../../components/chapter/Transcript.astro';
import { loadReferences, orderOfFirstUse, CITE_RE, NOTEREF_RE } from '../../lib/citations.ts';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const body = entry.body ?? '';
// Number citations and notes in order of first appearance; components read these while rendering.
Astro.locals.citeNumbers = orderOfFirstUse(body, CITE_RE);
Astro.locals.noteNumbers = orderOfFirstUse(body, NOTEREF_RE);
const all = loadReferences();
const refs = [...Astro.locals.citeNumbers.keys()].map((k) => {
  const r = all.get(k);
  if (!r) throw new Error(`${entry.id}: citation key "${k}" is not in content/citations.yaml`);
  return r;
});
const { Content } = await render(entry);
const components = { Widget, NightNote, Line, MathDrawer, Plate, Cite, NoteRef, NoteDef, Notes, Predict, WardBoard, Transcript };
const d = entry.data;
---
<Base title={`${d.title}: A Young Nurse's Illustrated Primer`} description={d.summary}>
  <article>
    <ChapterOpener number={d.number} title={d.title} summary={d.summary} plate={d.plate} />
    <ReviewFlag prose={d.review.prose} medical={d.review.medical} />
    <div class="column prose">
      <Content components={components} />
      <References refs={refs} />
    </div>
  </article>
</Base>
