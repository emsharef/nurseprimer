{
  "name": "nurseprimer",
  "version": "0.1.0",
  "private": true,
  "description": "A Young Nurse's Illustrated Primer: learn how modern AI works by building a telephone-triage nurse in the browser.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/site",
    "build": "npm run build -w apps/site",
    "preview": "npm run preview -w apps/site",
    "test": "vitest run",
    "audit:citations": "node scripts/citation-audit.mjs",
    "audit:version": "node scripts/version-check.mjs apps/site/dist",
    "lint:a11y": "node scripts/a11y-lint.mjs apps/site/dist",
    "check": "npm run audit:citations && npm test && npm run build && npm run audit:version && npm run lint:a11y",
    "deploy": "sh tools/deploy.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=23"
  }
}
